# Copier en .env puis remplir
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h
STARTING_CASH=1000          # capital fictif du mode paper
STATE_FILE=bot_state.json

# Uniquement pour le mode live. Clé API SANS droit de retrait.
API_KEY=
API_SECRET=
LIVE_TRADING=false          # passer à true + flag --i-understand-the-risks pour trader en réel
